
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function activeUser() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.status == "active";
    }

    function owner() {
      return activeUser()
        && get(userPath()).data.role == "owner";
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /items/{itemId} {
      allow read: if activeUser();
      allow create, update: if owner();
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if activeUser();

      allow create: if activeUser()
        && request.resource.data.name is string
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[0-9]{10}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "active";

      allow update, delete: if false;
    }

    match /advanceTransactions/{transactionId} {
      allow read: if activeUser();

      allow create: if activeUser()
        && request.resource.data.customerId is string
        && request.resource.data.customerName is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "active"
        && (
          (
            request.resource.data.type == "deposit"
            && request.resource.data.paymentMode in ["cash", "upi"]
          )
          ||
          (
            request.resource.data.type == "adjustment"
            && request.resource.data.saleId is string
            && existsAfter(
              /databases/$(database)/documents/sales/$(request.resource.data.saleId)
            )
          )
        );

      allow update, delete: if false;
    }

    match /sales/{saleId} {
      allow read: if activeUser();

      allow create: if activeUser()
        && request.resource.data.invoiceNumber is string
        && request.resource.data.customerName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.cashAmount is number
        && request.resource.data.upiAmount is number
        && request.resource.data.advanceUsed is number
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.paymentMode in ["cash", "upi", "advance", "split"];

      allow update: if owner();
      allow delete: if false;
    }

    match /invoiceCounters/{counterId} {
      allow read, create, update: if activeUser();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
